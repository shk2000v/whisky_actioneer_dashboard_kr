{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: events and opening Whisky Auctioneer lot pages in the default browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://whiskyauctioneer.com/*" }]
    }
  ]
}
